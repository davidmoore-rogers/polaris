[Unit]
Description=Polaris — web / control plane (HTTP, schedulers, migrations)
Documentation=https://github.com/davidmoore-rogers/polaris
After=network.target postgresql-15.service polaris-migrate.service
Requires=postgresql-15.service polaris-migrate.service
PartOf=polaris.target

[Service]
Type=simple
User=polaris
Group=polaris
WorkingDirectory=/opt/polaris
ExecStart=/usr/bin/node dist/index.js
# Shared env file for every role; the role itself is injected per-unit so it
# stays OUT of .env (which is identical across processes).
EnvironmentFile=/opt/polaris/.env
Environment=POLARIS_ROLE=web
Restart=on-failure
RestartSec=5

# Only the web role binds a port, so only it needs the bind capability.
AmbientCapabilities=CAP_NET_BIND_SERVICE
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/polaris
PrivateTmp=true

StandardOutput=journal
StandardError=journal
SyslogIdentifier=polaris-web

[Install]
WantedBy=polaris.target
