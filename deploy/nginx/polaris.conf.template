# deploy/nginx/polaris.conf.template — source of truth for the rendered
# /etc/nginx/conf.d/polaris.conf. The Polaris nginx renderer (see
# src/services/nginxRenderer.ts) substitutes placeholder tokens below from
# the operator's proxyConfig Setting plus a small set of env-derived values
# (server_name from POLARIS_PUBLIC_URL, upstream port from PORT).
#
# Settings managed by the Polaris UI (Server Settings -> Certificates):
# the HTTPS listen port, HTTP/3 (QUIC) on/off, TLS protocols allow-list,
# HSTS, and the Prometheus IP allow-list.
#
# Not managed by the UI: server_name (derived from POLARIS_PUBLIC_URL),
# cert paths (fixed at /etc/polaris-nginx/cert.pem and key.pem), WebSocket
# and proxy timeouts (fixed at 3600s), and upstream targets.
#
# Hand-edits to the rendered /etc/nginx/conf.d/polaris.conf trigger drift
# detection on the next in-app update: the rendered file is NOT clobbered
# and the GUI surfaces a banner until the operator clicks "Adopt managed
# mode." See ARCHITECTURE.md -> nginx Proxy Management for the full flow.
#
# WebSocket upgrade: RFC 6455 WebSockets work only over HTTP/1.1 and HTTP/2.
# The agent's persistent WebSocket and any browser WebSocket negotiate over
# TCP; the HTTP/3 advertisement header doesn't apply to the Upgrade:
# websocket handshake. The map block produces the canonical
# "upgrade-when-asked, close-otherwise" Connection header so a plain GET
# doesn't end up with a stray "Connection: upgrade".

map $http_upgrade $connection_upgrade {
  default upgrade;
  '' close;
}

server {
  # TCP listener — HTTP/2 (with HTTP/1.1 fallback for old clients)
  listen {{HTTPS_PORT}} ssl;
  http2 on;{{QUIC_LISTENER}}

  server_name {{SERVER_NAME}};

  ssl_certificate     /etc/polaris-nginx/cert.pem;
  ssl_certificate_key /etc/polaris-nginx/key.pem;
  ssl_protocols       {{SSL_PROTOCOLS_LIST}};
  # QUIC mandates TLS 1.3 — nginx enforces this automatically on the quic
  # listener; the ssl_protocols directive above only constrains the TCP side.
  ssl_session_cache shared:SSL:10m;
  ssl_session_timeout 1d;{{SSL_EARLY_DATA}}{{HSTS_HEADER}}

  # Default proxy headers shared by all locations. The TRUST_PROXY=1 setting
  # in Polaris's .env makes Express honor these so req.ip / req.secure /
  # session-cookie Secure flag all work correctly.
  proxy_set_header Host              $host;
  proxy_set_header X-Real-IP         $remote_addr;
  proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
  proxy_set_header X-Forwarded-Proto https;
  proxy_set_header X-Forwarded-Host  $host;
  proxy_set_header Authorization     $http_authorization;
  proxy_http_version 1.1;
  proxy_set_header Upgrade           $http_upgrade;
  proxy_set_header Connection        $connection_upgrade;

  # Generous timeouts for the agent's long-lived WebSocket. The default 60s
  # would tear down idle WS connections every minute. The agent's own
  # heartbeat fires inside this window.
  proxy_read_timeout 3600s;
  proxy_send_timeout 3600s;

  # Main app
  location / {
    proxy_pass http://127.0.0.1:{{POLARIS_PORT}};
  }

  # ─── Metrics endpoints ────────────────────────────────────────────────
  # IP-allowlisted to Prometheus (managed via Server Settings → Certificates).
  # Bearer auth (METRICS_TOKEN) gates the upstream; nginx adds IP allowlisting
  # as the first defense layer.
  location = /metrics {
{{METRICS_ALLOW_BLOCK}}    proxy_pass http://127.0.0.1:{{POLARIS_PORT}}/metrics;
  }

  location = /metrics-monitor-1 {
{{METRICS_ALLOW_BLOCK}}    proxy_pass http://127.0.0.1:9101/metrics;
  }

  location = /metrics-monitor-2 {
{{METRICS_ALLOW_BLOCK}}    proxy_pass http://127.0.0.1:9102/metrics;
  }

  location = /metrics-discovery {
{{METRICS_ALLOW_BLOCK}}    proxy_pass http://127.0.0.1:9110/metrics;
  }
}
