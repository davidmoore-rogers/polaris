[Unit]
Description=Polaris — discovery worker (pg-boss discovery-queue consumer)
Documentation=https://github.com/rogers-group-inc/polaris
After=network.target postgresql-15.service polaris-migrate.service
Requires=postgresql-15.service polaris-migrate.service
PartOf=polaris.target

[Service]
Type=simple
User=polaris
Group=polaris
WorkingDirectory=/opt/polaris
ExecStart=/usr/bin/node dist/index.js
EnvironmentFile=/opt/polaris/.env
Environment=POLARIS_ROLE=discovery
# Cross-integration discovery parallelism (per-integration runs are serialized
# by the queue's singletonKey). Default 2; raise only if you run many
# integrations that should discover concurrently:
#Environment=POLARIS_DISCOVERY_WORKERS=2
# /metrics listener (Prometheus scrape target). The web role exposes /metrics
# on the main HTTPS listener; discovery doesn't bind any Express server, so
# this port is the only way Prometheus can see in-process discovery duration
# + per-phase histograms and FMG proxy-lane gauges that live in this
# process's prom-client registry. Binds 127.0.0.1 by default; set
# POLARIS_METRICS_BIND=0.0.0.0 if your Prometheus runs off-host.
Environment=POLARIS_METRICS_PORT=9110
Restart=on-failure
RestartSec=5

# /metrics binds an unprivileged port on 127.0.0.1; no NET_BIND_SERVICE cap needed.
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/polaris
PrivateTmp=true

StandardOutput=journal
StandardError=journal
SyslogIdentifier=polaris-discovery

[Install]
WantedBy=polaris.target
